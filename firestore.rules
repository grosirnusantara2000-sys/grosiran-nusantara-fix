rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'grosirnusantara2000@gmail.com' ||
        request.auth.token.email == 'nelly.aliya00@gmail.com' ||
        request.auth.token.email == 'ramadhansyukri.st@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins registry collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Products catalog: public read & write
    match /products/{productId} {
      allow read, write, delete: if true;
    }

    // Categories: public read & write
    match /categories/{categoryId} {
      allow read, write, delete: if true;
    }

    // Product requests (Custom sourcing)
    match /productRequests/{requestId} {
      allow read, write, delete: if true;
    }

    // Orders
    match /orders/{orderId} {
      allow read, write, delete: if true;
    }

    // Reviews & Testimonials: public read, write
    match /reviews/{reviewId} {
      allow read, write, delete: if true;
    }

    // SEO Blog Articles: public read, write
    match /articles/{articleId} {
      allow read, write, delete: if true;
    }

    // Store settings & profile: public read and write so owner can customize profile and Google Sheets webhook
    match /storeSettings/{settingId} {
      allow read, write: if true;
    }

    // Activity logs: public read and write for audit trail
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // Real-time admin notifications
    match /notifications/{notifId} {
      allow read, write, delete: if true;
    }
  }
}
